# PdfSharpDsl feature demonstration
# Run from PdfSharpDslConsole with: dotnet run -- demo.ipdf
#
# One file per feature in demo-includes/, each starting a new page (INCLUDE splices the file in place,
# so the page order is the order below). A file can also be drawn alone: dotnet run -- demo-includes/05-text.ipdf

# Shared UDFs (SECTION, BADGE, __ONNEWPAGE), named styles and the "report" master.
INCLUDE "demo-common.ipdf";

INCLUDE "demo-includes/01-cover.ipdf";
INCLUDE "demo-includes/02-primitives.ipdf";
INCLUDE "demo-includes/03-charts.ipdf";
INCLUDE "demo-includes/04-report.ipdf";
INCLUDE "demo-includes/05-text.ipdf";
INCLUDE "demo-includes/06-control-flow.ipdf";
INCLUDE "demo-includes/07-tables.ipdf";
INCLUDE "demo-includes/08-merged-cells.ipdf";
INCLUDE "demo-includes/09-row-templates.ipdf";
INCLUDE "demo-includes/10-master.ipdf";
INCLUDE "demo-includes/11-flow.ipdf";
INCLUDE "demo-includes/12-images.ipdf";
INCLUDE "demo-includes/13-barcodes.ipdf";
INCLUDE "demo-includes/14-host-functions.ipdf";
INCLUDE "demo-includes/15-builtin-functions.ipdf";
INCLUDE "demo-includes/16-system-variables.ipdf";
INCLUDE "demo-includes/17-debug-options.ipdf";
INCLUDE "demo-includes/18-typography.ipdf";
INCLUDE "demo-includes/19-shapes.ipdf";
INCLUDE "demo-includes/20-layouts.ipdf";
