<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>$(NetLibTfms)</TargetFrameworks>
		<PackageReadmeFile>Readme.md</PackageReadmeFile>
		<Title>Generate PDF using DSL</Title>
		<PackageId>PdfSharpDslCore</PackageId>
		<UseLocalTerraPdf Condition="'$(UseLocalTerraPdf)' == '' and Exists('..\..\TerraPDF\src\TerraPDF\TerraPDF.csproj')">true</UseLocalTerraPdf>
		<Description>A DSL using TerraPDF to generate PDF</Description>
		<PackageIcon>Icon.jpg</PackageIcon>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Irony" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
		<PackageReference Include="TerraPDF" Condition="'$(UseLocalTerraPdf)' != 'true'" />
	</ItemGroup>
	<ItemGroup Condition="'$(UseLocalTerraPdf)' == 'true'">
		<ProjectReference Include="..\..\TerraPDF\src\TerraPDF\TerraPDF.csproj" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\PdfSharpDsl.Language\PdfSharpDsl.Language.csproj" />
	</ItemGroup>
	<ItemGroup>
		<InternalsVisibleTo Include="pdfsharpdslTests" />
	</ItemGroup>
	<!--
		Now that this project multi-targets, pack runs in the cross-targeting (outer) build,
		where the SDK does not expand its default None globs. So these must be Include, not
		Update: an Update would have nothing to attach the Pack metadata to and the icon and
		readme would silently drop out of the package (NU5046).
	-->
	<ItemGroup Condition="'$(TargetFramework)' == ''">
		<None Include="Icon.jpg" Pack="true" PackagePath="\" />
		<None Include="Readme.md" Pack="true" PackagePath="\" />
	</ItemGroup>

</Project>
